{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error response (common)",
  "type": "object",
  "additionalProperties": false,
  "required": ["errorCode", "errorMessage", "path", "success"],
  "properties": {
    "errorCode": {
      "type": "integer"
    },
    "errorMessage": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "success": {
      "const": false
    }
  }
}